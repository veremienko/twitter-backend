{
    "name": "twit-service",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "DATABASE_URL=postgres://twitter:twitter@localhost:5432/twitter_test REDIS_URL=redis://localhost:6380/1 node --env-file=../../.env --test --test-concurrency=1",
        "dev": "node --watch --env-file=../../.env src/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate"
    },
    "dependencies": {
        "@twitter/shared": "*",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "kafkajs": "^2.2.4",
        "pg": "^8.16.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.5",
        "@types/pg": "^8.15.6",
        "drizzle-kit": "^0.31.10"
    }
}
